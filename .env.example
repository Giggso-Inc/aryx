# Aryx environment variables — copy to .env and fill in real values.
# docker-compose reads .env automatically; never commit the real .env.

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# REQUIRED — compose will fail without this set.
POSTGRES_PASSWORD=change_me

# ── Aryx relational store ────────────────────────────────────────────────────
# Must point at the postgres container (default works for docker-compose).
ARYX_RDB_DSN=postgresql://aryx:${POSTGRES_PASSWORD}@postgres:5432/aryx

# ── Graph store (FalkorDB) ───────────────────────────────────────────────────
ARYX_GRAPH_URL=redis://falkordb:6379

# ── LLM provider ─────────────────────────────────────────────────────────────
# Localhost via docker-compose.local.yml:
#   set ARYX_LLM_BASE_URL to the shared dev-server Ollama endpoint.
#   ARYX_EMBED_ENDPOINT is optional; when omitted it falls back to ARYX_LLM_BASE_URL.
# OCI/dev-server via docker-compose.yml:
#   this file is ignored for Ollama endpoint wiring; compose uses http://ollama:11434.
# Set ARYX_LLM_PROVIDER to one of: ollama, openai, anthropic, gemini
ARYX_LLM_PROVIDER=ollama
ARYX_LLM_BASE_URL=http://<dev-server-host>:11434
ARYX_EMBED_MODEL=nomic-embed-text
# ARYX_EMBED_ENDPOINT=http://<dev-server-host>:11434

# Model names — must exist on your provider.
ARYX_LLM_MENIAL_MODEL=llama3.2:3b
ARYX_LLM_REASON_MODEL=llama3.2:3b

# API key — required for openai/anthropic/gemini providers; leave empty for ollama.
ARYX_LLM_API_KEY=

# Embedding backend — 'local' (Ollama, default), 'oci' (OCI GenAI Cohere
# Embed v3), or 'gemini' (reuses ARYX_LLM_API_KEY, pins output to 768-dim to
# match the documents.embedding column — see docs/LLM_GEMINI_MIGRATION_PLAN.md).
# ARYX_EMBED_BACKEND=gemini

# Timeouts and concurrency.
ARYX_LLM_TIMEOUT=360
ARYX_PER_DOC_TIMEOUT=600
ARYX_DOC_WORKERS=1

# ── Ontology interchange ─────────────────────────────────────────────────────
ARYX_ONTOLOGY_ENABLED=true
ARYX_ONTOLOGY_FORMATS=turtle,json-ld,xml,n-triples

# ── Next.js web app ──────────────────────────────────────────────────────────
# Internal URL the Next.js container uses to reach the FastAPI container.
ARYX_API_URL_INTERNAL=http://api:8000
# Internal URL the Next.js container uses to reach Shay inside docker-compose.
SHAY_API_URL_INTERNAL=http://shay-api:8000
# Shared Aryx service token used by Shay and Next.js server routes for internal calls.
ARYX_INTERNAL_API_KEY=change_me_internal_aryx_token
# Recommended for datasource secret encryption in shared/dev environments.
# Must be a Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ARYX_SECRET_KEY=
# 32-byte hex key used only by Shay backend for invitation / verification token wrapping.
SHAY_TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Required for OAuth state signing; do not leave blank outside tests.
SSO_STATE_SECRET=change_me_sso_state_secret
# Shay JWT/session signing secret.
SECRET_KEY=change_me_shay_secret_key

# ── Shay public URLs ─────────────────────────────────────────────────────────
# In OCI dev, replace localhost with https://aryx.shay-ai.com and keep the
# /shay and /shay/api paths aligned with the nginx reverse-proxy config.
PLATFORM_NAME=Aryx
# Canonical frontend root. PLATFORM_URL and APP_URL are derived from this.
FRONTEND_URL=http://localhost:3000
# Canonical public Shay backend root. BASE_URL is derived as SHAY_BE_PUBLIC_URL + /api.
SHAY_BE_PUBLIC_URL=http://localhost:3000/shay
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SUPPORT_EMAIL=support@aryx.com

# ── Shay email / SMTP ────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=support@giggso.com
SMTP_PASS=change_me_smtp_password
SMTP_FROM=support@giggso.com
SMTP_SECURE=true

# ── OAuth provider credentials for Shay auth / SSO ──────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/shay/api/v1/sso/google/callback
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:3000/shay/api/v1/gmail/connect/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:3000/shay/api/v1/sso/microsoft/callback
SF_CONNECT_REDIRECT_URI=http://localhost:3000/shay/api/v1/sf/connect/callback
ZOHO_CRM_CONNECT_REDIRECT_URI=http://localhost:3000/shay/api/v1/zoho/connect/callback

# Public MCP endpoint shown in Settings → MCP Tokens.
# Set this for production deployments; omit for local dev (defaults to :8765).
# NEXT_PUBLIC_MCP_URL=https://aryx.example.com/mcp
# Optional MCP runtime overrides when running MCP outside docker-compose.
# ARYX_API_URL=http://localhost:8088
# ARYX_MCP_DEFAULT_WORKSPACE=1
# ARYX_MCP_POST_TIMEOUT=50

# ── Security ─────────────────────────────────────────────────────────────────
# API auth mode for direct Aryx REST access: off | optional | required
ARYX_API_AUTH=off
# Allow missing API keys in middleware while keeping route-level guards active.
# ARYX_MCP_AUTH_OPTIONAL=1

# ── Logging ──────────────────────────────────────────────────────────────────
ARYX_LOG_LEVEL=INFO
ARYX_BATCH_SIZE=500

# ── Scalability caps — raise for large datasets ───────────────────────────────
ARYX_MAX_BLOCK_SIZE=5000       # Resolution: max records per blocking group before group is skipped
ARYX_GRAPH_QUERY_LIMIT=500     # Graph query: max entities returned per query
ARYX_MAX_RELATE_PAIRS=50       # Pipeline: max entity pairs evaluated for relationship inference
ARYX_TRANSITIVE_MAX_DEPTH=4    # Reasoning: max transitive closure hops (set 8-10 for deep org charts)
ARYX_WORKER_THREADS=4          # Concurrent pipeline workers (ThreadPoolExecutor; 1 = sequential)
