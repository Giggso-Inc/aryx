# Aryx — 12-factor configuration. Copy to .env and adjust. NEVER commit .env.
# All app settings are read from ARYX_-prefixed environment variables.

# Canonical relational store (P1: RDB is the source of truth).
ARYX_RDB_DSN=postgresql://aryx:aryx@postgres:5432/aryx

# Derived, rebuildable graph projection.
ARYX_GRAPH_URL=redis://falkordb:6379

ARYX_LOG_LEVEL=INFO
ARYX_BATCH_SIZE=500

# Scalability caps — raise these for large datasets.
ARYX_MAX_BLOCK_SIZE=5000       # Resolution: max records per blocking group before group is skipped
ARYX_GRAPH_QUERY_LIMIT=500     # Graph query: max entities returned per query
ARYX_MAX_RELATE_PAIRS=50       # Pipeline: max entity pairs evaluated for relationship inference
ARYX_TRANSITIVE_MAX_DEPTH=4    # Reasoning: max transitive closure hops (set 8-10 for deep org charts)
ARYX_WORKER_THREADS=4          # Concurrent pipeline workers (ThreadPoolExecutor; 1 = sequential)

# Used only by docker-compose to seed the local postgres container.
POSTGRES_PASSWORD=aryx
