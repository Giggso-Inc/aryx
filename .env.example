# Aryx — 12-factor configuration. Copy to .env and adjust. NEVER commit .env.
# All app settings are read from ARYX_-prefixed environment variables.

# Canonical relational store (P1: RDB is the source of truth).
ARYX_RDB_DSN=postgresql://aryx:aryx@postgres:5432/aryx

# Derived, rebuildable graph projection. A password is optional; URL-encode it
# when supplied, for example redis://:encoded-password@falkordb:6379.
ARYX_GRAPH_URL=redis://falkordb:6379

ARYX_LOG_LEVEL=INFO
ARYX_BATCH_SIZE=500

# Optional static credential for a service-to-service integration. It is
# accepted alongside active tokens issued through /admin/mcp/tokens; it does
# not replace managed-token support. Keep ARYX_API_AUTH optional in this
# compatibility release so existing unauthenticated callers are unaffected.
ARYX_SERVICE_API_KEY=
ARYX_API_AUTH=optional

# Optional workspace scopes for the new catalog and entity-management APIs.
# Empty values preserve generic Open Source behavior: an authenticated caller
# may use either API for any workspace. Set either to 51 in the R3 deployment.
ARYX_CATALOG_ALLOWED_WORKSPACE_IDS=
ARYX_ENTITY_MANAGEMENT_ALLOWED_WORKSPACE_IDS=

# LLM runtime (Ask + ingest). Also editable live at /settings in the web UI.
# Keys in Settings stay in process memory; env sets boot defaults.
ARYX_LLM_PROVIDER=ollama
ARYX_LLM_BASE_URL=http://ollama:11434
ARYX_LLM_MENIAL_MODEL=qwen3.5:0.8b
ARYX_LLM_REASON_MODEL=lfm2.5-thinking:latest
ARYX_LLM_API_KEY=
# Examples:
#   ARYX_LLM_PROVIDER=google
#   ARYX_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   ARYX_LLM_PROVIDER=xai
#   ARYX_LLM_BASE_URL=https://api.x.ai/v1

# Used only by docker-compose to seed the local postgres container.
POSTGRES_PASSWORD=aryx
