# ─────────────────────────────────────────────────────────────────────────────
# Aryx OCI-mode stack, backed by a LOCAL Oracle container — environment variables
#
# Full list of every var docker-compose-oci-local.yml's services read — not a
# diff against .env.example.oci. Copy this whole file's content into your
# existing .env (docker-compose-oci.yml and docker-compose-oci-local.yml share
# ONE .env by explicit decision — see
# docs/LOCAL_OCI_ORACLE_STACK_PLAN_2026-09-15.md) whenever switching to local
# Oracle testing; copy .env.example.oci's content back to switch to the real
# cloud ADB. Only the DATABASE section differs between the two files below.
#
# Setup order:
#   1. Copy this file's content into .env (fill every <REQUIRED>)
#   2. docker compose -f docker-compose-oci-local.yml up -d
#   3. Wait for `oracle` to report healthy (first boot: 1-3 minutes) —
#      api/shay-api wait on it automatically (depends_on: condition:
#      service_healthy), this is just what to expect.
# ─────────────────────────────────────────────────────────────────────────────


# ── OCI Core ──────────────────────────────────────────────────────────────────
ARYX_OCI_MODE=true
ARYX_OCI_REGION=us-chicago-1
ARYX_OCI_COMPARTMENT_ID=<REQUIRED>                  # ocid1.compartment.oc1..<hash> — still needed: OCI Functions/Object Storage/GenAI calls are unrelated to which database backs the stack


# ── OCI API Auth ──────────────────────────────────────────────────────────────
# Used by oci_client.py when not running on OCI Compute (instance principal).
ARYX_OCI_USER_OCID=<REQUIRED>
ARYX_OCI_TENANCY_OCID=<REQUIRED>
ARYX_OCI_FINGERPRINT=<REQUIRED>
ARYX_OCI_PRIVATE_KEY_CONTENT=<REQUIRED>


# ── Database — LOCAL Oracle Database 23ai Free (plain TCP, no TLS/wallet) ────
# This is the ONLY section that differs from .env.example.oci.
#
# gvenzl/oracle-free:23-slim — checked before choosing this: no 24/25/26 tag
# exists on Docker Hub as of this writing; 23ai also matches the real ADB
# instance's version family (JSON, VECTOR, SQL/PGQ), which is the point.
#
# ORACLE_PASSWORD is the container's own SYS/SYSTEM password — distinct from
# the app schema user below. Only used by the `oracle` service itself.
ORACLE_PASSWORD=<REQUIRED>                          # local dev only — pick any strong value

# ARYX_DB_USER/ARYX_DB_PASSWORD double as the gvenzl image's APP_USER/
# APP_USER_PASSWORD (docker-compose-oci-local.yml wires them through) — this
# auto-creates the schema user on first boot. No manual CREATE USER needed;
# oracle-init/01-grant-property-graph.sh grants the one extra privilege
# (CREATE PROPERTY GRAPH) that auto-created user doesn't get by default.
ARYX_DB_USER=aryx_local                             # any valid Oracle identifier
ARYX_DB_PASSWORD=<REQUIRED>                         # local dev only — pick any strong value

# Easy-connect DSN to the `oracle` service on the compose network — no TCPS
# descriptor, no wallet, unlike the cloud ADB DSN in .env.example.oci.
# FREEPDB1 is gvenzl/oracle-free's default pluggable database service name.
ARYX_OCI_ADB_DSN=oracle:1521/FREEPDB1
ARYX_RDB_DSN=oracle:1521/FREEPDB1                   # same value as ARYX_OCI_ADB_DSN — C-01: ~55 routes read get_settings().rdb_dsn directly


# ── OCI Functions — aryx-ingest-fn ───────────────────────────────────────────
ARYX_OCI_INGEST_FN_ID=<REQUIRED_after_provisioner>  # ocid1.fnfunc.oc1..<hash> — real OCI service, unrelated to local vs. cloud DB


# ── Object Storage ────────────────────────────────────────────────────────────
ARYX_OCI_OBJECT_STORAGE_NAMESPACE=<REQUIRED>
ARYX_OCI_DOCUMENT_BUCKET=aryx-doc-output
ARYX_OCI_RDF_BUCKET=aryx-rdf-exports


# ── Web / API internal URL ─────────────────────────────────────────────────────
ARYX_API_URL_INTERNAL=http://api:8000
ARYX_INTERNAL_API_KEY=change_me_internal_aryx_token
ARYX_SECRET_KEY=
SHAY_TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SSO_STATE_SECRET=change_me_sso_state_secret
SECRET_KEY=change_me_shay_secret_key
# Shay DATABASE_URL is built inline in docker-compose-oci-local.yml from
# ARYX_DB_USER, ARYX_DB_PASSWORD, and ARYX_OCI_ADB_DSN (the local values
# above) — no separate SHAY_DATABASE_URL required.
SHAY_API_URL_INTERNAL=http://shay-api:8000

# ── Shay public URLs ─────────────────────────────────────────────────────────
PLATFORM_NAME=Aryx
FRONTEND_URL=http://localhost:3000
SHAY_BE_PUBLIC_URL=http://localhost:8090
ALLOWED_ORIGINS=http://localhost:3000
SUPPORT_EMAIL=support@aryx.com

# ── Shay email / SMTP ────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=support@giggso.com
SMTP_PASS=change_me_smtp_password
SMTP_FROM=support@giggso.com
SMTP_SECURE=true

# ── OAuth provider credentials for Shay auth / SSO ──────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/shay/api/v1/sso/google/callback
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:3000/shay/api/v1/gmail/connect/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:3000/shay/api/v1/sso/microsoft/callback
SF_CONNECT_REDIRECT_URI=http://localhost:3000/shay/api/v1/sf/connect/callback
ZOHO_CRM_CONNECT_REDIRECT_URI=http://localhost:3000/shay/api/v1/zoho/connect/callback


# ── Optional: model overrides ─────────────────────────────────────────────────
ARYX_LLM_CHEAP_MODEL_OVERRIDE=cohere.command-a-03-2025
ARYX_LLM_FRONTIER_MODEL_OVERRIDE=cohere.command-a-03-2025
ARYX_EMBED_MODEL_OVERRIDE=cohere.embed-multilingual-v3.0


# ── LLM runtime (Ask UI) ──────────────────────────────────────────────────────
ARYX_LLM_PROVIDER=oci
ARYX_LLM_MENIAL_MODEL=cohere.command-a-03-2025
ARYX_LLM_REASON_MODEL=cohere.command-a-03-2025
ARYX_LLM_BASE_URL=                                     # not used on OCI path — leave blank
ARYX_EMBED_DIM=1024                                    # Cohere embed-multilingual-v3.0 — 1024-dim vectors


# ── Common settings (apply regardless of local vs. cloud DB) ────────────────
ARYX_LOG_LEVEL=INFO
ARYX_BATCH_SIZE=500

# CPQ native-UI layout export directory — must point at config_layouts/ baked
# into the image, or LocalDirLayoutFileSource silently finds no layout files.
ARYX_CPQ_LAYOUT_DIR=/app/config_layouts

# DB connection pool sizing — default 25 covers one /graph request's
# subgraph() fan-out (up to 8 connections) plus concurrent CPQ turn
# processing and admin-endpoint polling in the same worker.
ARYX_DB_POOL_MAX_SIZE=25

# Pipeline timeouts + concurrency
ARYX_LLM_TIMEOUT=900
ARYX_PER_DOC_TIMEOUT=7200
ARYX_JOB_TIMEOUT_MINUTES=120
ARYX_DOC_WORKERS=1
ARYX_WORKER_THREADS=4
ARYX_INGEST_WORKERS=3
ARYX_RELATE_WORKERS=4
ARYX_RELATE_MAX_ATTRS=15
ARYX_INGEST_RELATE=true

# Document chunking
ARYX_CHUNK_SIZE=1000
ARYX_CHUNK_OVERLAP=100
ARYX_CSV_CHUNK_ROWS=5000
ARYX_XML_MAX_ENTITY_TYPES=10000
ARYX_XML_MAX_ROWS_PER_TYPE=10000

# Scalability caps
ARYX_MAX_BLOCK_SIZE=50000
ARYX_MAX_PAIRS_PER_BLOCK=2000
ARYX_GRAPH_QUERY_LIMIT=5000
ARYX_MAX_RELATE_PAIRS=50
ARYX_TRANSITIVE_MAX_DEPTH=4
ARYX_RULES_DB_WARN_THRESHOLD=20
ARYX_DISCOVERY_MAX_PAYLOAD_MB=512

# Entity resolution thresholds
ARYX_ER_AUTO_MERGE=0.95
ARYX_ER_ADJUDICATE=0.95
ARYX_ER_REVIEW=0.75
ARYX_EMBED_BATCH_SIZE=50

# Ontology interchange
ARYX_ONTOLOGY_ENABLED=true
ARYX_ONTOLOGY_FORMATS=turtle,json-ld,xml,n-triples

# Security — API auth mode for direct Aryx REST access: off | optional | required
ARYX_API_AUTH=false                                    # docker-compose-oci-local.yml default — matches docker-compose-oci.yml's own default for the trusted web-container proxy path

# ── Raven structured logging (raven_log) ─────────────────────────────────────
# Structured JSON records for ingestion and CPQ retrieval. All optional.
# ARYX_RAVEN_LOG_ENABLED=false turns every call into a no-op (rollback switch).
# LEVEL: DEBUG | INFO | WARN | ERROR (records below it are dropped).
# SINK: stdout | s3 | both. The S3 vars are only read when SINK is s3 or both.
ARYX_RAVEN_LOG_ENABLED=true
ARYX_RAVEN_LOG_LEVEL=INFO
ARYX_RAVEN_LOG_SINK=stdout
# Secret for the digests that stand in for customer text in logs. Set the same value on every
# pod so equal texts match across the deployment; unset = random per process (never guessable).
# ARYX_RAVEN_LOG_HASH_KEY=
# ARYX_RAVEN_LOG_S3_PATH=s3://<bucket>/<prefix>
# ARYX_RAVEN_LOG_S3_ACCESS_ID=
# ARYX_RAVEN_LOG_S3_ACCESS_TOKEN=
# ARYX_RAVEN_LOG_S3_REGION=
# ARYX_RAVEN_LOG_S3_FLUSH_SECONDS=5
# ARYX_RAVEN_LOG_S3_BATCH_MAX=500
# ARYX_RAVEN_LOG_S3_QUEUE_MAX=20000
