  "stack": {
    "language": ["python", "typescript"],
    "frontend": ["next.js", "react", "tailwindcss"],
    "data": ["falkordb", "pgvector", "postgresql"],
    "db": ["postgresql", "falkordb"],
    "infra": ["docker", "docker-compose"],
    "cloud": "none",
    "libraries": [
      "anthropic",
      "boto3",
      "cryptography",
      "falkordb",
      "fastapi",
      "mcp",
      "oracledb",
      "pgvector",
