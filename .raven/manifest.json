      "next",
      "react",
      "react-dom",
      "react-markdown",
      "remark-gfm",
      "tailwind-merge"
    ]
  },
  "standards": "raven-v1",
  "guard": {
    "enabled": true,
    "version": "1.0",
    "thresholds": {
      "secrets_in_staged": "hard_block",
      "cve_critical_cvss_gt_7": "hard_block",
      "force_push": "hard_block",
      "rows_deleted_gt": 100,
      "rows_deleted_action": "approval_flow",
      "schema_drop": "hard_block_escalate",
      "port_0000_opened": "hard_block_escalate",
      "truncation_detected": "hard_block_escalate"
    }
  },
  "style": {
    "max_file_lines": 400,
    "max_function_lines": 60,
    "require_type_hints": true,
    "require_docstrings": false,
    "require_logging": true,
    "naming": {
      "python": "snake_case",
      "typescript": "camelCase",
      "components": "PascalCase"
    },
    "enforce_at": "commit"
  },
  "approved_skills": [
    "andie-jr",
    "andie",
    "manifest-checker",
    "stack-validator",
    "style-enforcer",
    "architecture-guard",
    "secret-guard",
    "db-guard",
    "guard-git-watch",
    "skill-guard",
    "mcp-guard",
    "pool-fitter",
    "auth-warden",
    "block-smith",
    "survivor-smith"
  ],
