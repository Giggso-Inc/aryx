# ─────────────────────────────────────────────────────────────────────────────
# Aryx OCI deployment — environment variables
# Copy to .env on the VM and fill in every value marked <REQUIRED>.
#
# Setup order:
#   1. Fill ARYX_OCI_CORE + ARYX_DB_* sections first
#   2. docker login <region>.ocir.io  (see OCIR section below)
#   3. docker build + push the function image
#   4. Run the provisioner → paste the printed OCID into ARYX_OCI_INGEST_FN_ID
#   5. docker compose -f docker-compose-oci.yml up -d
# ─────────────────────────────────────────────────────────────────────────────


# ── OCI Core ──────────────────────────────────────────────────────────────────
# OCI_MODE=true routes all backends to OCI automatically.
# Per-service vars (ARYX_DB_BACKEND etc.) are optional overrides.
ARYX_OCI_MODE=true
ARYX_OCI_REGION=us-chicago-1                        # e.g. eu-frankfurt-1, ap-sydney-1
ARYX_OCI_COMPARTMENT_ID=<REQUIRED>                  # ocid1.compartment.oc1..<hash>


# ── OCI API Auth ──────────────────────────────────────────────────────────────
# Used by oci_client.py when not running on OCI Compute (instance principal).
# Auth resolution order: instance principal → env vars → ~/.oci/config
#
# How to get these values:
#   OCI Console → Identity → Users → <your user> → API Keys → Add API Key
#   After adding, the console shows user OCID, tenancy OCID, and fingerprint.
#
# ARYX_OCI_PRIVATE_KEY_CONTENT: paste the full PEM on one line with \n for newlines, or
#   use: export ARYX_OCI_PRIVATE_KEY_CONTENT="$(cat ~/.oci/oci_api_key.pem)"
ARYX_OCI_USER_OCID=<REQUIRED>                            # ocid1.user.oc1..<hash>
ARYX_OCI_TENANCY_OCID=<REQUIRED>                         # ocid1.tenancy.oc1..<hash>
ARYX_OCI_FINGERPRINT=<REQUIRED>                          # xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx
ARYX_OCI_PRIVATE_KEY_CONTENT=<REQUIRED>                  # -----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----


# ── Database — Oracle ADB 23ai (TLS, no wallet) ───────────────────────────────
# DSN format: tcps://<adb-host>:1522/<service_name>_<level>
# Service levels: _high / _medium / _low / _tp / _tpurgent
ARYX_OCI_ADB_DSN=<REQUIRED>                         # tcps://adb.<region>.oraclecloud.com:1522/<db>_high
ARYX_DB_USER=<REQUIRED>                             # Oracle schema user (e.g. aryx_user)
ARYX_DB_PASSWORD=<REQUIRED>                         # Oracle schema password
#
# C-01: workspace_api, ask_history_api, jobs_api, rules_api and ~55 other
# routes read get_settings().rdb_dsn directly. Setting this to the same value
# as ARYX_OCI_ADB_DSN is what makes those routes work in OCI mode.
ARYX_RDB_DSN=<REQUIRED — same value as ARYX_OCI_ADB_DSN>


# ── OCI Functions — aryx-ingest-fn ───────────────────────────────────────────
# Run the provisioner once after pushing the function image to get this OCID.
#
#   python -c "
#   from aryx.worker.oci_functions_provisioner import provision_ingest_function
#   ocid = provision_ingest_function(
#       subnet_id='ocid1.subnet.oc1...', image_uri='<region>.ocir.io/<ns>/aryx/aryx-ingest-fn:latest')
#   print('ARYX_OCI_INGEST_FN_ID=' + ocid)"
ARYX_OCI_INGEST_FN_ID=<REQUIRED_after_provisioner>  # ocid1.fnfunc.oc1..<hash>


# ── Object Storage ────────────────────────────────────────────────────────────
# Namespace: OCI Console → Storage → Object Storage → any bucket → Namespace (top of page)
ARYX_OCI_OBJECT_STORAGE_NAMESPACE=<REQUIRED>        # e.g. axkemthipsFT
#
# Bucket 1 — Document Understanding output (Standard, lifecycle: delete > 7 days)
ARYX_OCI_DOCUMENT_BUCKET=aryx-doc-output
# ARYX_OCI_DOCUMENT_FEATURES=TEXT_DETECTION,TABLE_DETECTION,KEY_VALUE_DETECTION  # default
#
# Bucket 2 — RDF/OWL ontology exports (Standard, versioning enabled — retain last 5)
ARYX_OCI_RDF_BUCKET=aryx-rdf-exports


# ── Web / API internal URL ─────────────────────────────────────────────────────
# Used by the Next.js web service to reach FastAPI inside docker-compose.
ARYX_API_URL_INTERNAL=http://api:8000


# ── Optional: model overrides ─────────────────────────────────────────────────
# OCI GenAI Chat API models — cohere.command-r-16k is end-of-life; use 08-2024.
ARYX_LLM_CHEAP_MODEL_OVERRIDE=cohere.command-r-08-2024
ARYX_LLM_FRONTIER_MODEL_OVERRIDE=cohere.command-r-plus-08-2024
# ARYX_EMBED_MODEL_OVERRIDE=


# ── Per-service backend overrides ─────────────────────────────────────────────
# ARYX_OCI_MODE=true already routes all backends to OCI.
# Uncomment individual vars only when you need to override a specific service.
# ARYX_PARSE_BACKEND=           # local (pymupdf) or oci (Document Understanding)
# ARYX_EMBED_BACKEND=           # local (Ollama) or oci (OCI GenAI Cohere Embed v3)
# ARYX_LLM_CHEAP_BACKEND=       # local or oci (Command R)
# ARYX_LLM_FRONTIER_BACKEND=    # local or oci (Command R+)
# ARYX_DB_BACKEND=              # local (Postgres) or oci (Oracle ADB 23ai)
# ARYX_GRAPH_BACKEND=           # falkordb or oci_graph (Oracle Graph Studio)
# ARYX_WORKER_BACKEND=          # local, oci_functions, or oci_dataflow
# ARYX_GRAPH_URL=redis://localhost:6379  # FalkorDB URL — only needed if ARYX_GRAPH_BACKEND=falkordb

# ── LLM runtime (Ask UI) ──────────────────────────────────────────────────────
# Controls which model appears in the observability screen.
# Without these, the runtime falls back to "llama3.2:3b" (Ollama defaults).
ARYX_LLM_PROVIDER=oci
ARYX_LLM_MENIAL_MODEL=cohere.command-r-08-2024        # fast/cheap turns (tool selection, rewrites)
ARYX_LLM_REASON_MODEL=cohere.command-r-plus-08-2024   # deep reasoning turns (entity extraction, answer)
ARYX_LLM_BASE_URL=                                     # not used on OCI path — leave blank
# ARYX_LLM_API_KEY=             # API key for cloud LLM providers (OpenAI, Anthropic, Gemini) — not needed for OCI GenAI

# Cohere embed-multilingual-v3.0 produces 1024-dim vectors (default is 768 for local Ollama).
# Must match the pgvector column width — change only if you switch embed models.
ARYX_EMBED_DIM=1024


# ── Optional: OCI Data Flow (batch pipeline, not needed for Functions path) ───
# ARYX_OCI_DATAFLOW_APP_ID=


# ── Common settings (apply regardless of OCI mode) ───────────────────────────

# Logging
ARYX_LOG_LEVEL=INFO
ARYX_BATCH_SIZE=500

# Pipeline timeouts + concurrency
ARYX_LLM_TIMEOUT=900
ARYX_PER_DOC_TIMEOUT=7200
ARYX_JOB_TIMEOUT_MINUTES=120
ARYX_DOC_WORKERS=1
ARYX_WORKER_THREADS=4
ARYX_INGEST_WORKERS=3           # Parallel tabular plan workers (final plan always runs serial)
ARYX_RELATE_WORKERS=4           # Concurrent LLM calls in relate stage
ARYX_RELATE_MAX_ATTRS=15        # Max entity attributes sent to LLM per relate call

# Document chunking
ARYX_CHUNK_SIZE=1000             # Target chunk size in characters
ARYX_CHUNK_OVERLAP=100           # Overlap in characters between adjacent chunks

# Ontology interchange
ARYX_ONTOLOGY_ENABLED=true
ARYX_ONTOLOGY_FORMATS=turtle,json-ld,xml,n-triples
# ARYX_ONTOLOGY_BASE_URI=https://aryx.local/  # RDF namespace base — change to your domain if publishing exports externally

# Scalability caps — raise for large datasets
ARYX_MAX_BLOCK_SIZE=5000         # Resolution: max records per blocking group before skipped
ARYX_MAX_PAIRS_PER_BLOCK=200    # Resolution: max pairs scored per block (lower = faster, fewer merges)
ARYX_GRAPH_QUERY_LIMIT=500      # Graph query: max entities returned per query
ARYX_MAX_RELATE_PAIRS=10        # Pipeline: max entity pairs evaluated for relationship inference
ARYX_INGEST_RELATE=false        # Pipeline: enable LLM relationship inference for CSV/XML (disabled — large payloads can hang)
ARYX_TRANSITIVE_MAX_DEPTH=4     # Reasoning: max transitive closure hops
ARYX_CSV_CHUNK_ROWS=0           # Split CSV into N-row chunks before ingest (0 = off)
ARYX_XML_MAX_ENTITY_TYPES=20    # Max distinct XML element types extracted per file
ARYX_XML_MAX_ROWS_PER_TYPE=500  # Max rows kept per XML entity type after extraction
ARYX_RULES_DB_WARN_THRESHOLD=20 # Warn when workspace has more than N enabled rules

# Entity resolution thresholds — lower values = more merges
ARYX_ER_AUTO_MERGE=0.92         # Score >= this triggers automatic merge (no LLM, no human)
ARYX_ER_ADJUDICATE=0.90         # Score in [adjudicate, auto_merge) triggers LLM adjudication
ARYX_ER_REVIEW=0.75             # Score in [review, adjudicate) queues pair for human review
ARYX_EMBED_BATCH_SIZE=50        # Records per embedding batch during entity resolution

# Security — set to a random 32+ char value to protect Next.js proxy routes
# ARYX_PROXY_SECRET=

# Next.js public MCP URL — shown in Settings → MCP Tokens
# Set to your OCI Load Balancer / public hostname in production
# NEXT_PUBLIC_MCP_URL=https://aryx.example.com/mcp


# ─────────────────────────────────────────────────────────────────────────────
# OCIR — Oracle Container Registry (for pushing the function image)
# These are NOT read by aryx — they are for `docker login` only.
#
#   docker login <ARYX_OCI_REGION>.ocir.io \
#     --username <ARYX_OCI_OBJECT_STORAGE_NAMESPACE>/<oci-username> \
#     --password <auth-token>
#
# Auth token: OCI Console → top-right avatar → User Settings → Auth Tokens
# ─────────────────────────────────────────────────────────────────────────────
