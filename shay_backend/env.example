# Log Analyzer Backend - Environment Configuration
# Copy these variables to your environment or use them as reference for DevOps

# Application Settings
DEBUG=false
APP_NAME="Log Analyzer Backend"
APP_VERSION="1.0.0"

# Platform Configuration
PLATFORM_URL="http://localhost:3000"
APP_URL="https://app-loganalyzer.shay-ai.com/login"
# Optional: base URL for View Channel link when platform is Accsell; if not set, PLATFORM_URL is used
# SHAY_PLATFORM_URL="https://app.shay.com"

# Logo URLs for email headers (channel member notification); only used when platform_name is accsell or zaptag
# SHAY_LOGO_URL="https://dev-shay.shay-ai.com/assets/ShayLogoWithName-C71lIFKk.png"
# ZAPTAG_LOGO_URL="https://dev-accell.shay-ai.com/assets/AccsellLogoWithName-C71lIFKk.png"

# Marketplace platform (for /api/v1/payment-gateway/zoho/subscriptions/validation/{user_id})
# When true, channel and message limits are read from CHANNEL_COUNT and MESSAGE_COUNT below
IS_MARKETPLACE=false
CHANNEL_COUNT=1
MESSAGE_COUNT=50

# Security
SECRET_KEY="your-super-secret-key-change-this-in-production"
# Required for internal Shay -> Aryx service calls.
ARYX_INTERNAL_API_KEY="change-me-internal-aryx-token"
# 32-byte hex key used to wrap invitation and verification tokens in links.
SHAY_TOKEN_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
SSO_STATE_SECRET="change-me-sso-state-secret"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database - Set this for your environment
# Development (local)
DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/log_analyzer"
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# OAuth2 (Google)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/sso/google/callback"
# Gmail workspace connectivity proxy — register this URI in Google Cloud Console.
# Prod: set to https://your-shay-backend-domain/api/v1/gmail/connect/callback
GOOGLE_GMAIL_REDIRECT_URI="http://localhost:8000/api/v1/gmail/connect/callback"

# CORS
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
ALLOWED_HOSTS=["localhost", "127.0.0.1"]

# File Upload
MAX_FILE_SIZE=104857600  # 100MB in bytes
ALLOWED_FILE_TYPES=[".log", ".txt", ".json", ".xml"]
UPLOAD_DIR="uploads"

# File Storage URLs
LOCAL_FILES_URL="https://shaydev-mk.giggso.com/staticFiles/contentfile/"

# Vault Integration
CREDENTIALS_MGMT_KV_ENDPOINT="https://your-vault-endpoint.com"
CREDENTIALS_MGMT_VAULT_TOKEN="your-vault-token"
GIGGSO_CONNECTIONS_PATH_PARAM="giggso-connections"

# AI Integration
OPENAI_API_KEY="your-openai-api-key"
ANTHROPIC_API_KEY="your-anthropic-api-key"
N8N_WEBHOOK_URL="https://your-n8n-instance.com/webhook/log-analysis"
PIPEDREAM_WEBHOOK_URL="https://your-pipedream-url.com"

# Logging
LOG_LEVEL="INFO"
LOG_FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s" 

# Log Type Configuration
SUPPORTED_LOG_TYPES="android,kubernetes,python,java,nodejs,go,rust,php,ruby,dotnet"

# Salesforce CRM workspace connect OAuth proxy
# Create a Salesforce Connected App with scopes: api, api.All, refresh_token, openid
# Enable OAuth and PKCE. Register SF_CONNECT_REDIRECT_URI as the callback URL.
# Prod: set to https://your-shay-backend-domain/api/v1/sf/connect/callback
SF_CONNECT_CLIENT_ID=XXXXXXXXXX
SF_CONNECT_CLIENT_SECRET=XXXXXXXXXX
SF_CONNECT_REDIRECT_URI=http://localhost:8000/api/v1/sf/connect/callback

# Zoho CRM workspace connect OAuth proxy
# Create a Zoho Connected App at https://api-console.zoho.com with scopes:
#   ZohoCRM.modules.ALL, ZohoCRM.settings.ALL, ZohoCRM.users.ALL
# Register ZOHO_CRM_CONNECT_REDIRECT_URI as an authorized redirect URI in that app.
# Prod: set to https://your-shay-backend-domain/api/v1/zoho/connect/callback
ZOHO_CRM_CONNECT_CLIENT_ID=XXXXXXXXXX
ZOHO_CRM_CONNECT_CLIENT_SECRET=XXXXXXXXXX
ZOHO_CRM_CONNECT_REDIRECT_URI=http://localhost:8000/api/v1/zoho/connect/callback

# Zoho Configuration
ZOHO_BASE_URL=https://www.zohoapis.com
ZOHO_CLIENT_ID=XXXXXXXXXX
ZOHO_CLIENT_SECRET=XXXXXXXXXX
ZOHO_REDIRECT_URI=http://localhost:3001
ZOHO_REFRESH_TOKEN=XXXXXXXXXX
ZOHO_TOKEN_URL=https://accounts.zoho.com/oauth/v2/token
PRODUCT_ID=68080XXXXXXXXXX
ZOHO_ORGANIZATION_ID=XXXXXXXXXX

# PRISM Zoho Configuration (for prism7 platform)
# These are used when platform_name is 'prism7' in Zoho payment-related API requests
PRISM_ZOHO_BASE_URL=https://www.zohoapis.com
PRISM_ZOHO_CLIENT_ID=XXXXXXXXXX
PRISM_ZOHO_CLIENT_SECRET=XXXXXXXXXX
PRISM_ZOHO_REDIRECT_URI=http://localhost:3001
PRISM_ZOHO_REFRESH_TOKEN=XXXXXXXXXX
PRISM_ZOHO_TOKEN_URL=https://accounts.zoho.com/oauth/v2/token
PRISM_PRODUCT_ID=68080XXXXXXXXXX
PRISM_ZOHO_ORGANIZATION_ID=XXXXXXXXXX

# Shay Zoho Configuration (for accsell platform)
# These are used when platform_name is 'accsell' in Zoho payment-related API requests
SHAY_ZOHO_BASE_URL=https://www.zohoapis.com
SHAY_ZOHO_CLIENT_ID=XXXXXXXXXX
SHAY_ZOHO_CLIENT_SECRET=XXXXXXXXXX
SHAY_ZOHO_REDIRECT_URI=http://localhost:3001
SHAY_ZOHO_REFRESH_TOKEN=XXXXXXXXXX
SHAY_ZOHO_TOKEN_URL=https://accounts.zoho.com/oauth/v2/token
SHAY_PRODUCT_ID=68080XXXXXXXXXX
SHAY_ZOHO_ORGANIZATION_ID=XXXXXXXXXX

# ZAPTAG Zoho Configuration (for zaptag platform)
# These are used when platform_name is 'zaptag' in Zoho payment-related API requests
ZAPTAG_ZOHO_BASE_URL=https://www.zohoapis.com
ZAPTAG_ZOHO_CLIENT_ID=XXXXXXXXXX
ZAPTAG_ZOHO_CLIENT_SECRET=XXXXXXXXXX
ZAPTAG_ZOHO_REDIRECT_URI=http://localhost:3001
ZAPTAG_ZOHO_REFRESH_TOKEN=XXXXXXXXXX
ZAPTAG_ZOHO_TOKEN_URL=https://accounts.zoho.com/oauth/v2/token
ZAPTAG_PRODUCT_ID=68080XXXXXXXXXX
ZAPTAG_ZOHO_ORGANIZATION_ID=XXXXXXXXXX

# Zoho OAuth Configuration
# Get these from https://api-console.zoho.com (US region)
# Note: ZOHO_CLIENT_ID, ZOHO_CLIENT_SECRET, ZOHO_REDIRECT_URI, ZOHO_REFRESH_TOKEN, ZOHO_TOKEN_URL
# are already defined above in the Zoho Configuration section

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@shay.com
SMTP_SECURE=true

# Socket Configuration
SOCKET_SERVER_URL=http://localhost:3000
SOCKET_TIMEOUT=10000
SOCKET_RECONNECTION=true
SOCKET_RECONNECTION_ATTEMPTS=10
SOCKET_RECONNECTION_DELAY=1000
SOCKET_RECONNECTION_DELAY_MAX=5000
SOCKET_AUTO_CONNECT=true
SOCKET_TRANSPORTS=websocket,polling
SOCKET_NAMESPACE=
SOCKET_HEARTBEAT_INTERVAL=30000
SOCKET_HEARTBEAT_TIMEOUT=60000
SOCKET_AUTH_TOKEN=
SOCKET_DEBUG=false

# Public-facing base URL of shay_backend (used to build the Odoo connect form URL).
# Must be set in prod — request.base_url resolves to the internal Docker hostname otherwise.
SHAY_BE_PUBLIC_URL=https://your-shay-domain.com

# Orchestrator URL (used by Odoo connect proxy to verify credentials).
# shay_backend forwards the user's Bearer token to the orchestrator on authenticated calls.
ORCHESTRATOR_URL=http://localhost:9000

# ── Gmail Connect OAuth ───────────────────────────────────────────────────────
# Reuses the existing GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET above (no new app needed).
# Register this URI in Google Cloud Console → OAuth 2.0 → Authorized redirect URIs.
# Enable the Gmail API and add scope: https://www.googleapis.com/auth/gmail.readonly
# Dev:  http://localhost:8000/api/v1/gmail/connect/callback
# Prod: https://dev-api.shay-ai.com/api/v1/gmail/connect/callback
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:8000/api/v1/gmail/connect/callback

# ── Zoho CRM Connect OAuth ────────────────────────────────────────────────────
# Create a separate Zoho Connected App at https://api-console.zoho.com
# (different from the billing Zoho app — needs ZohoCRM.modules.ALL scopes).
# Register ZOHO_CRM_CONNECT_REDIRECT_URI as an authorized redirect URI.
# Dev:  http://localhost:8000/api/v1/zoho/connect/callback
# Prod: https://dev-api.shay-ai.com/api/v1/zoho/connect/callback
ZOHO_CRM_CONNECT_CLIENT_ID=
ZOHO_CRM_CONNECT_CLIENT_SECRET=
ZOHO_CRM_CONNECT_REDIRECT_URI=http://localhost:8000/api/v1/zoho/connect/callback

# ── Salesforce Connect OAuth ──────────────────────────────────────────────────
# Create a Salesforce Connected App with OAuth + PKCE enabled.
# Scopes needed: api, refresh_token, offline_access
# Register SF_CONNECT_REDIRECT_URI as the callback URL in the Connected App.
# Dev:  http://localhost:8000/api/v1/sf/connect/callback
# Prod: https://dev-api.shay-ai.com/api/v1/sf/connect/callback
SF_CONNECT_CLIENT_ID=
SF_CONNECT_CLIENT_SECRET=
SF_CONNECT_REDIRECT_URI=http://localhost:8000/api/v1/sf/connect/callback
